# ==============================================================================
# GESTARIAN PRO - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env y rellena las claves según los servicios que utilices.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE OAUTH & GMAIL API (Lectura automática de facturas y recibos)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"

# Aliases para el escaneo de Gmail en segundo plano
gmail_client_id="YOUR_GMAIL_CLIENT_ID"
gmail_client_secret="YOUR_GMAIL_CLIENT_SECRET"
# Token de actualización para lectura automática desatendida (cron)
gmail_refresh_token="YOUR_GMAIL_REFRESH_TOKEN"

# ------------------------------------------------------------------------------
# 2. PLATE RECOGNIZER API (Reconocimiento automático de matrículas y vehículos)
# Obtén tu token en: https://platerecognizer.com
# ------------------------------------------------------------------------------
PLATE_RECOGNIZER_API_KEY="your_platerecognizer_token_here"
VITE_PLATE_RECOGNIZER_API_KEY="your_platerecognizer_token_here"

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (Extracción OCR de facturas, permisos de circulación y Metis)
# Obtén tu clave gratuita en: https://aistudio.google.com
# ------------------------------------------------------------------------------
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 4. RESEND API (Envío de correos, códigos de verificación y facturas/presupuestos)
# Obtén tu clave en: https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="notificaciones@gestarian.com"
VITE_APP_EMAIL_FROM="notificaciones@gestarian.com"

# ------------------------------------------------------------------------------
# 5. SUPABASE (Base de datos en la nube, sincronización y enlaces de documentos)
# Obtén estos valores en Project Settings -> API en: https://supabase.com
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# 6. URLs DE LA APLICACIÓN Y REPOSITORIO
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
VITE_APP_BASE_URL="http://localhost:3000"
GITHUB_REPO_URL="https://github.com/iclomsinks-a11y/Gestarian-Pro.git"

# ------------------------------------------------------------------------------
# 7. CERTIFICADO DIGITAL Y SEDE ELECTRÓNICA AEAT (Veri*Factu telemático)
# ------------------------------------------------------------------------------
AEAT_CERT_PATH="/path/to/your/certificate.p12"
AEAT_CERT_PASSWORD="YOUR_CERT_PASSWORD"

# ------------------------------------------------------------------------------
# 8. CONFIGURACIÓN DEL SERVIDOR LOCAL
# ------------------------------------------------------------------------------
PORT=3000
DEFAULT_APP_PORT=3000
NODE_ENV=development
